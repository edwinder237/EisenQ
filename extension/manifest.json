{
  "manifest_version": 3,
  "name": "EisenQ Capture",
  "version": "0.3.0",
  "description": "Capture the page you're on, or the text you've selected, into an EisenQ quadrant.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "panel.html"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "https://www.eisenq.app/*", "https://eisenq.app/*"]
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "EisenQ"
  },
  "options_page": "options.html",
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Open or fold the EisenQ panel"
    }
  }
}
